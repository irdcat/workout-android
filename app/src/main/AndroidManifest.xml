<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The rest timer can vibrate when a rest ends. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Rest alerts on time with the app in the background (Android 12+ asks the user). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".WorkoutApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkoutJetpack">
        <activity
            android:name=".application.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WorkoutJetpack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".infrastructure.settings.RestAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>